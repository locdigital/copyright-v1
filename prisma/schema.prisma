generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  CONTENT_MANAGER
  REVIEWER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  CLOSED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ImageStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum TrademarkStatus {
  NO_VISIBLE_TRADEMARK
  TRADEMARK_VISIBLE
  TRADEMARK_PERMISSION_PROVIDED
  EDITORIAL_USE_ONLY
  REQUIRES_MANUAL_REVIEW
}

enum LicenseType {
  STANDARD
  EXTENDED
  EDITORIAL
  ENTERPRISE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Admin {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  passwordHash String
  role         AdminRole  @default(CONTENT_MANAGER)
  avatarUrl    String?
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  uploadedImages Image[]
  auditLogs      AuditLog[]

  @@index([email])
}

model User {
  id                 String        @id @default(cuid())
  fullName           String
  email              String        @unique
  passwordHash       String
  avatarUrl          String?
  accountStatus      AccountStatus @default(ACTIVE)
  subscriptionPlanId String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  contributor Contributor?
  purchases   Purchase[]
  favorites   Favorite[]
  downloads   Download[]

  @@index([email])
}

model Contributor {
  id                 String             @id @default(cuid())
  userId             String             @unique
  displayName        String
  biography          String?
  portfolioUrl       String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  totalUploads       Int                @default(0)
  totalDownloads     Int                @default(0)
  totalEarnings      Decimal            @default(0) @db.Decimal(12, 2)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  images Image[]
}

model Image {
  id                       String          @id @default(cuid())
  title                    String
  slug                     String          @unique
  shortDescription         String?
  fullDescription          String?
  altText                  String
  pageTitle                String?
  metaDescription          String?
  canonicalUrl             String?
  originalFileUrl          String
  previewFileUrl           String?
  thumbnailUrl             String?
  watermarkFileUrl         String?
  fileName                 String
  fileExtension            String
  mimeType                 String
  fileSize                 Int
  width                    Int?
  height                   Int?
  orientation              String?
  primaryColor             String?
  categoryId               String
  contributorId            String?
  uploadedByAdminId        String?
  standardLicensePrice     Decimal         @default(19) @db.Decimal(10, 2)
  extendedLicensePrice     Decimal         @default(79) @db.Decimal(10, 2)
  currency                 String          @default("USD")
  copyrightOwner           String
  copyrightNotice          String?
  trademarkStatus          TrademarkStatus @default(NO_VISIBLE_TRADEMARK)
  trademarkName            String?
  trademarkDisclaimer      String?
  commercialUseAllowed     Boolean         @default(true)
  editorialUseOnly         Boolean         @default(false)
  modelReleaseAvailable    Boolean         @default(false)
  propertyReleaseAvailable Boolean         @default(false)
  status                   ImageStatus     @default(DRAFT)
  rejectionReason          String?
  featured                 Boolean         @default(false)
  publishedAt              DateTime?
  scheduledAt              DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  deletedAt                DateTime?

  category        Category        @relation(fields: [categoryId], references: [id])
  contributor     Contributor?    @relation(fields: [contributorId], references: [id], onDelete: SetNull)
  uploadedByAdmin Admin?          @relation(fields: [uploadedByAdminId], references: [id], onDelete: SetNull)
  keywords        ImageKeyword[]
  purchaseItems   PurchaseItem[]
  favorites       Favorite[]
  downloads       Download[]

  @@index([categoryId])
  @@index([contributorId])
  @@index([uploadedByAdminId])
  @@index([status, publishedAt])
  @@index([deletedAt])
}

model Category {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  thumbnailUrl String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  images Image[]
}

model Keyword {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  createdAt DateTime       @default(now())

  images ImageKeyword[]
}

model ImageKeyword {
  imageId   String
  keywordId String
  createdAt DateTime @default(now())

  image   Image   @relation(fields: [imageId], references: [id], onDelete: Cascade)
  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([imageId, keywordId])
}

model License {
  id                    String      @id @default(cuid())
  name                  String
  licenseType           LicenseType
  description           String?
  usageLimit            String?
  commercialUse         Boolean     @default(true)
  redistributionAllowed Boolean     @default(false)
  resaleAllowed         Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  purchaseItems PurchaseItem[]
}

model Purchase {
  id                   String        @id @default(cuid())
  userId               String
  totalAmount          Decimal       @db.Decimal(10, 2)
  currency             String        @default("USD")
  paymentStatus        PaymentStatus @default(PENDING)
  paymentMethod        String?
  transactionReference String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PurchaseItem[]

  @@index([userId])
}

model PurchaseItem {
  id                String    @id @default(cuid())
  purchaseId        String
  imageId           String
  licenseId         String
  price             Decimal   @db.Decimal(10, 2)
  downloadCount     Int       @default(0)
  downloadLimit     Int       @default(5)
  downloadExpiresAt DateTime?
  createdAt         DateTime  @default(now())

  purchase  Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  image     Image      @relation(fields: [imageId], references: [id])
  license   License    @relation(fields: [licenseId], references: [id])
  downloads Download[]

  @@index([purchaseId])
  @@index([imageId])
  @@index([licenseId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  imageId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([userId, imageId])
  @@index([imageId])
}

model Download {
  id             String   @id @default(cuid())
  userId         String
  imageId        String
  purchaseItemId String?
  ipAddress      String?
  userAgent      String?
  downloadedAt   DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  image        Image         @relation(fields: [imageId], references: [id])
  purchaseItem PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([imageId])
  @@index([purchaseItemId])
}

model AuditLog {
  id           String   @id @default(cuid())
  adminId      String?
  action       String
  entityType   String
  entityId     String?
  previousData Json?
  newData      Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([action])
}
